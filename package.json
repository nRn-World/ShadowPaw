{
  "name": "shadow-paw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').cpSync('Sounds', 'dist/Sounds', {recursive: true})\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bake:cat-atlas": "node scripts/bake-cat-atlas.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:smoke": "node scripts/qa-smoke.mjs",
    "check": "npm run typecheck && npm run check:i18n && npm run build"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
